DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/db_goodwe?sslmode=require
JWT_SECRET_KEY=sua_chave_secreta_aqui
GEMINI_API_KEY=sua_chave_gemini

# RAG local: coloque PDFs/TXT/MD/CSV/JSON em backend/data/documents/
RAG_DOCUMENTS_DIR=backend/data/documents

# Desligado por padrão; usa somente estações ativas e campos públicos
RAG_ENABLE_DATABASE=true

# Desligado por padrão para não enviar perguntas privadas para a web
RAG_ENABLE_WEB_SEARCH=false

# Google Programmable Search opcional; sem estas variáveis usa DuckDuckGo
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
